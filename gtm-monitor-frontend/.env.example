# Copy menjadi .env (di-gitignore) sebelum npm run build / npm run dev.
# Site key Cloudflare Turnstile untuk captcha halaman login (publik, terlihat di halaman).
# WAJIB diisi bila TURNSTILE_SECRET_KEY di gtm-monitor-backend/.env diisi — tanpa site key, widget tidak tampil
# dan backend menolak semua login (CAPTCHA_REQUIRED).
VITE_TURNSTILE_SITE_KEY=isi-site-key-turnstile
