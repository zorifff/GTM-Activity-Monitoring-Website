# Copy file ini menjadi .env dan isi dengan nilai yang sesuai
# Jangan pernah commit file .env ke GitHub!

# === DATABASE (Neon PostgreSQL) ===
# Dapatkan dari: https://console.neon.tech → Project → Connection String
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# === JWT SECRET ===
# Bisa diisi string apapun yang panjang dan acak
JWT_SECRET="ganti-dengan-secret-key-yang-kuat"

# === CLOUDINARY (untuk penyimpanan foto) ===
# Dapatkan dari: https://console.cloudinary.com → Dashboard
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# === AKUN ADMIN (dipakai oleh update-admin.js) ===
# Jalankan: node update-admin.js untuk membuat / memperbarui akun admin
ADMIN_USERNAME="username-admin"
ADMIN_PASSWORD="ganti-dengan-password-admin-yang-kuat"

# === COOKIE SESI & CORS ===
# COOKIE_SECURE: kosongkan = otomatis (Secure di HTTPS/localhost, tanpa Secure di HTTP IP LAN)
#                "true" = selalu Secure (pakai bila semua akses sudah HTTPS)
COOKIE_SECURE=""
# Origin frontend yang boleh memanggil API dengan cookie (pisahkan dengan koma)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# === REFRESH TOKEN ===
# Kunci HMAC-SHA256 untuk hash refresh token di database (string acak panjang, berbeda dari JWT_SECRET)
# Buat dengan: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
REFRESH_TOKEN_SECRET="ganti-dengan-string-acak-panjang"

# === REDIS (antrean kerja BullMQ: OCR gambar program & import Excel ODP) ===
# Default: Redis di WSL Ubuntu yang dijalankan otomatis oleh npm run dev / pm2 (scripts/redis-wsl.js)
REDIS_URL="redis://127.0.0.1:6379"
