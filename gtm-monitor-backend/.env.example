# Copy file ini menjadi .env dan isi dengan nilai yang sesuai
# Jangan pernah commit file .env ke GitHub!

# === DATABASE (Neon PostgreSQL + PostGIS) ===
# Dapatkan dari: https://console.neon.tech → Project → Connect
# DATABASE_URL : pooled connection (centang "Connection pooling" → host berakhiran "-pooler"), dipakai aplikasi.
#                pgbouncer=true, connection_limit & pool_timeout ditambahkan otomatis (src/config/database.js)
# DIRECT_URL   : koneksi langsung (host yang sama TANPA "-pooler"), khusus prisma migrate & pg_dump
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DATABASE?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/DATABASE?sslmode=require"
# Koneksi Prisma maksimal per proses (API & worker masing-masing) & detik menunggu koneksi kosong
DB_CONNECTION_LIMIT="10"
DB_POOL_TIMEOUT_SEC="20"
# Batas waktu transaksi import Excel ODP (ms) & interval refresh terjadwal materialized view metrik performa (menit)
ODP_IMPORT_TX_TIMEOUT_MS="240000"
PERFORMANCE_REFRESH_MINUTES="60"

# === JWT SECRET ===
# Bisa diisi string apapun yang panjang dan acak
JWT_SECRET="ganti-dengan-secret-key-yang-kuat"

# === CLOUDINARY (untuk penyimpanan foto) ===
# Dapatkan dari: https://console.cloudinary.com → Dashboard
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# === AKUN ADMIN (dipakai oleh update-admin.js) ===
# Jalankan: node update-admin.js untuk membuat / memperbarui akun admin
ADMIN_USERNAME="username-admin"
ADMIN_PASSWORD="ganti-dengan-password-admin-yang-kuat"

# === COOKIE SESI & CORS ===
# COOKIE_SECURE: kosongkan = otomatis (Secure di HTTPS/localhost, tanpa Secure di HTTP IP LAN)
#                "true" = selalu Secure (pakai bila semua akses sudah HTTPS)
COOKIE_SECURE=""
# Origin frontend yang boleh memanggil API dengan cookie (pisahkan dengan koma)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# === CLOUDFLARE TURNSTILE (captcha halaman login) ===
# Secret key dari Cloudflare Dashboard → Turnstile → widget. Kosong = login tanpa verifikasi captcha (tidak untuk produksi).
# Pasangannya (site key) diisi di gtm-monitor-frontend/.env sebagai VITE_TURNSTILE_SITE_KEY.
TURNSTILE_SECRET_KEY="isi-secret-key-turnstile"

# === REFRESH TOKEN ===
# Kunci HMAC-SHA256 untuk hash refresh token di database (string acak panjang, berbeda dari JWT_SECRET)
# Buat dengan: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
REFRESH_TOKEN_SECRET="ganti-dengan-string-acak-panjang"

# === REDIS (antrean kerja BullMQ: OCR gambar program & import Excel ODP) ===
# Default: Redis di WSL Ubuntu yang dijalankan otomatis oleh npm run dev / pm2 (scripts/redis-wsl.js)
REDIS_URL="redis://127.0.0.1:6379"

# === OBJECT STORAGE S3-compatible (foto kegiatan terverifikasi & file Excel sementara) ===
# Lokal (default): Garage di WSL — jalankan sekali "npm run storage:setup" (root); nilai di bawah diisi otomatis.
# Cloudflare R2 : S3_ENDPOINT="https://<ACCOUNT_ID>.r2.cloudflarestorage.com"  S3_REGION="auto"  S3_FORCE_PATH_STYLE="true"
# AWS S3        : S3_ENDPOINT="https://s3.ap-southeast-3.amazonaws.com"         S3_REGION="ap-southeast-3"  S3_FORCE_PATH_STYLE="false"
S3_ENDPOINT="http://127.0.0.1:3900"
S3_REGION="garage"
S3_BUCKET="gtm-media"
S3_ACCESS_KEY_ID="isi-access-key-id"
S3_SECRET_ACCESS_KEY="isi-secret-access-key"
S3_FORCE_PATH_STYLE="true"

# === DATABASE UJI LOKAL (hanya npm test: migrasi, import transaksional, PostGIS, pooling) ===
# Diisi otomatis oleh: npm run db:test:setup (root) — PostgreSQL + PostGIS di WSL di belakang PgBouncer.
# Database ini DI-RESET setiap kali suite "database" berjalan; jangan arahkan ke Neon.
TEST_DATABASE_URL="postgresql://gtm:PASSWORD@127.0.0.1:6433/gtm_test?pgbouncer=true"
TEST_DIRECT_URL="postgresql://gtm:PASSWORD@127.0.0.1:5433/gtm_test"
