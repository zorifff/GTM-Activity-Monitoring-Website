# Copy file ini menjadi .env dan isi dengan nilai yang sesuai
# Jangan pernah commit file .env ke GitHub!

# === DATABASE (Neon PostgreSQL) ===
# Dapatkan dari: https://console.neon.tech → Project → Connection String
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# === JWT SECRET ===
# Bisa diisi string apapun yang panjang dan acak
JWT_SECRET="ganti-dengan-secret-key-yang-kuat"

# === CLOUDINARY (untuk penyimpanan foto) ===
# Dapatkan dari: https://console.cloudinary.com → Dashboard
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# === AKUN ADMIN (dipakai oleh update-admin.js) ===
# Jalankan: node update-admin.js untuk membuat / memperbarui akun admin
ADMIN_USERNAME="username-admin"
ADMIN_PASSWORD="ganti-dengan-password-admin-yang-kuat"
