// url       : pooled connection (Neon PgBouncer, host "-pooler") — dipakai aplikasi; parameter pool diatur src/config/database.js
// directUrl : koneksi langsung — dipakai prisma migrate (butuh fitur sesi yang tidak didukung PgBouncer mode transaction)
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// Metrik hasil hitung (port, OCC, jumlah ODP per status) tidak disimpan di tabel: tersedia di materialized view
// "BranchPerformance" & "RegionalPerformance" (lihat migrasi 20261026120000 & src/services/performance.service.js)
model Branch {
  id             Int             @id @default(autoincrement())
  name           String          @unique
  projects       Project[]
  users          User[]
  reportedMetric ReportedMetric?
}

// Waktu import terakhir per kunci (mis. "jateng_diy_summary") — angka ringkasannya ada di ReportedMetric
model ImportMeta {
  id            Int      @id @default(autoincrement())
  key           String   @unique
  updatedAt     DateTime @updatedAt
}

// Angka resmi yang DILAPORKAN file Excel (bukan hasil hitung): OCC BRANCH & GAP WOW per branch, baris ringkasan Jateng DIY.
// Satu baris per cakupan: scope "region" (branchId kosong) atau "branch:<branchId>" (dijaga CHECK constraint di migrasi).
model ReportedMetric {
  id        Int      @id @default(autoincrement())
  scope     String   @unique
  branch    Branch?  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  branchId  Int?     @unique
  occRate   Float?   // OCC (0.0 - 1.0)
  gapWoW    Float?   // Delta OCC minggu ke minggu
  available Int?     // Khusus region: total port tersedia
  used      Int?     // Khusus region: total port terpakai
  total     Int?     // Khusus region: total port
  updatedAt DateTime @updatedAt
}


model Project {
  id         String                 @id @default(uuid())
  name       String
  wok        String
  typeDesign String?                @default("Greenfield")
  branch     Branch                 @relation(fields: [branchId], references: [id])
  branchId   Int
  odps       Odp[]
  activities ProjectActivity[]
  photos     ProjectActivityPhoto[]

  @@index([branchId])
}

model Odp {
  id         String     @id @default(uuid())
  odp        String     @unique
  avai       Int
  used       Int
  total      Int
  // Sumber koordinat (PostGIS, SRID 4326 / WGS84) + indeks spasial GiST. Ditulis lewat SQL (src/services/odpGeo.service.js)
  location   Unsupported("geometry(Point,4326)")?
  // lat/lon = GENERATED ALWAYS AS (ST_Y/ST_X(location)) STORED → hanya-baca; jangan diisi lewat create/update
  lat        Float?     @default(dbgenerated("st_y(location)"))
  lon        Float?     @default(dbgenerated("st_x(location)"))
  occStatus  String?    @default("GREEN")
  project    Project    @relation(fields: [projectId], references: [id])
  projectId  String

  @@index([location], type: Gist)
  @@index([projectId])
}

model ProjectActivity {
  id         String    @id @default(uuid())
  type       String
  status     String    @default("belum") // "belum", "upload", "verified"
  photoUrl   String?
  planDate   DateTime?
  actualDate DateTime?
  keterangan String?

  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId  String

  user       User?     @relation(fields: [userId], references: [id])
  userId     Int?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([projectId, type])
}

model ProjectActivityPhoto {
  id         String    @id @default(uuid())
  type       String    // "tsel_menyapa", "branding_outlet", "bumdes", "rekrutmen_sf", "open_table"
  status     String    @default("upload") // "upload" (Menunggu Verifikasi), "verified"
  photoUrl   String?
  planDate   DateTime?
  namaOutlet String?
  namaBumdes String?
  kodeSf     String?
  keterangan String?

  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId  String

  user       User?     @relation(fields: [userId], references: [id])
  userId     Int?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model User {
  id         Int                    @id @default(autoincrement())
  username   String                 @unique
  password   String                 // Hashed password
  fullName   String
  role       String                 @default("USER") // "USER" | "ADMIN"
  branch     Branch?                @relation(fields: [branchId], references: [id])
  branchId   Int?                   // Null jika ADMIN
  activities ProjectActivity[]
  photos     ProjectActivityPhoto[]
  sessions   AuthSession[]
  createdAt  DateTime               @default(now())
}

// Sesi login per perangkat — sekaligus revocation list (revokedAt terisi = sesi dibatalkan paksa)
model AuthSession {
  id            String         @id @default(uuid())
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        Int
  expiresAt     DateTime       // Batas mutlak sesi (7 hari sejak login)
  revokedAt     DateTime?
  revokedReason String?        // "logout" | "reuse_detected" | "admin_revoked" | "password_changed"
  userAgent     String?
  ipAddress     String?
  lastUsedAt    DateTime       @default(now())
  createdAt     DateTime       @default(now())
  refreshTokens RefreshToken[]

  @@index([userId])
}

// Refresh token (rotasi): yang disimpan hanya hash HMAC-SHA256, bukan token aslinya
model RefreshToken {
  id        String      @id @default(uuid())
  tokenHash String      @unique
  session   AuthSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId String
  expiresAt DateTime
  rotatedAt DateTime?   // Terisi saat token sudah ditukar dengan token baru (sekali pakai)
  createdAt DateTime    @default(now())

  @@index([sessionId])
}

