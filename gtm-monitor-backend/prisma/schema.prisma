datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Branch {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  occRate  Float?    // Nilai OCC BRANCH langsung dari file Excel (0.0 - 1.0)
  gapWoW   Float?    // Nilai GAP WOW dari file Excel (delta minggu ke minggu)
  projects Project[]
  users    User[]
}

model ImportMeta {
  id            Int      @id @default(autoincrement())
  key           String   @unique  // e.g. "jateng_diy_summary"
  occRate       Float?   // Total Occupancy Rate Jateng DIY
  available     Int?     // Total Port Tersedia Jateng DIY
  used          Int?     // Total Port Terpakai
  total         Int?     // Total Port Keseluruhan
  gapWoW        Float?   // GAP WOW regional
  updatedAt     DateTime @updatedAt
}


model Project {
  id         String                 @id @default(uuid())
  name       String
  wok        String
  typeDesign String?                @default("Greenfield")
  branch     Branch                 @relation(fields: [branchId], references: [id])
  branchId   Int
  odps       Odp[]
  activities ProjectActivity[]
  photos     ProjectActivityPhoto[]
}

model Odp {
  id         String     @id @default(uuid())
  odp        String     @unique
  avai       Int
  used       Int
  total      Int
  lat        Float?
  lon        Float?
  occStatus  String?    @default("GREEN")
  project    Project    @relation(fields: [projectId], references: [id])
  projectId  String
}

model ProjectActivity {
  id         String    @id @default(uuid())
  type       String
  status     String    @default("belum") // "belum", "upload", "verified"
  photoUrl   String?
  planDate   DateTime?
  actualDate DateTime?
  keterangan String?

  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId  String

  user       User?     @relation(fields: [userId], references: [id])
  userId     Int?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([projectId, type])
}

model ProjectActivityPhoto {
  id         String    @id @default(uuid())
  type       String    // "tsel_menyapa", "branding_outlet", "bumdes", "rekrutmen_sf", "open_table"
  status     String    @default("upload") // "upload" (Menunggu Verifikasi), "verified"
  photoUrl   String?
  planDate   DateTime?
  namaOutlet String?
  namaBumdes String?
  kodeSf     String?
  keterangan String?

  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId  String

  user       User?     @relation(fields: [userId], references: [id])
  userId     Int?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model User {
  id         Int                    @id @default(autoincrement())
  username   String                 @unique
  password   String                 // Hashed password
  fullName   String
  role       String                 @default("USER") // "USER" | "ADMIN"
  branch     Branch?                @relation(fields: [branchId], references: [id])
  branchId   Int?                   // Null jika ADMIN
  activities ProjectActivity[]
  photos     ProjectActivityPhoto[]
  sessions   AuthSession[]
  createdAt  DateTime               @default(now())
}

// Sesi login per perangkat — sekaligus revocation list (revokedAt terisi = sesi dibatalkan paksa)
model AuthSession {
  id            String         @id @default(uuid())
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        Int
  expiresAt     DateTime       // Batas mutlak sesi (7 hari sejak login)
  revokedAt     DateTime?
  revokedReason String?        // "logout" | "reuse_detected" | "admin_revoked" | "password_changed"
  userAgent     String?
  ipAddress     String?
  lastUsedAt    DateTime       @default(now())
  createdAt     DateTime       @default(now())
  refreshTokens RefreshToken[]

  @@index([userId])
}

// Refresh token (rotasi): yang disimpan hanya hash HMAC-SHA256, bukan token aslinya
model RefreshToken {
  id        String      @id @default(uuid())
  tokenHash String      @unique
  session   AuthSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId String
  expiresAt DateTime
  rotatedAt DateTime?   // Terisi saat token sudah ditukar dengan token baru (sekali pakai)
  createdAt DateTime    @default(now())

  @@index([sessionId])
}

