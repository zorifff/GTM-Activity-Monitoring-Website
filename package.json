{
  "name": "gtm-activity-monitoring",
  "version": "1.0.0",
  "scripts": {
    "dev": "concurrently --names \"REDIS,STORAGE,BACKEND,WORKER,FRONTEND\" --prefix-colors \"red,green,cyan,yellow,magenta\" \"node gtm-monitor-backend/scripts/redis-wsl.js\" \"node gtm-monitor-backend/scripts/storage-wsl.js\" \"node gtm-monitor-backend/server.js\" \"node gtm-monitor-backend/worker.js\" \"npm run dev --prefix gtm-monitor-frontend\"",
    "backend": "node gtm-monitor-backend/server.js",
    "worker": "node gtm-monitor-backend/worker.js",
    "redis": "node gtm-monitor-backend/scripts/redis-wsl.js",
    "storage": "node gtm-monitor-backend/scripts/storage-wsl.js",
    "storage:setup": "node gtm-monitor-backend/scripts/setup-storage-wsl.js",
    "storage:ls": "node gtm-monitor-backend/scripts/storage-ls.js",
    "storage:migrate-photos": "node gtm-monitor-backend/scripts/migrate-photos-to-storage.js",
    "db:migrate": "npm run db:migrate --prefix gtm-monitor-backend",
    "db:status": "npm run db:status --prefix gtm-monitor-backend",
    "db:backup": "node gtm-monitor-backend/scripts/backup-db-wsl.js",
    "db:test:setup": "node gtm-monitor-backend/scripts/setup-postgres-wsl.js",
    "db:test": "node gtm-monitor-backend/scripts/postgres-wsl.js",
    "postman:server": "node gtm-monitor-backend/scripts/postman-server.js",
    "frontend": "npm run dev --prefix gtm-monitor-frontend",
    "pm2:start": "pm2 start ecosystem.config.js && pm2 save",
    "pm2:stop": "pm2 stop ecosystem.config.js",
    "pm2:restart": "pm2 restart ecosystem.config.js",
    "pm2:status": "pm2 status",
    "pm2:logs": "pm2 logs"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
